# Supabase Configuration
# Get your credentials from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Secret Key
# Generate a secure random string for JWT token signing
JWT_SECRET_KEY=your_jwt_secret_key_here

# Groq API Configuration
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# External API Keys for Market Intelligence

# The Companies API - Company data enrichment and competitive analysis
# Get your API key from: https://www.thecompaniesapi.com/
# Documentation: https://www.thecompaniesapi.com/api
COMPANIES_API_KEY=your_companies_api_key_here

# Alpha Vantage API - Stock prices, financial data, and market metrics
# Get your API key from: https://www.alphavantage.co/support/#api-key
# Documentation: https://www.alphavantage.co/documentation/
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# News API - News articles and industry trends
# Get your API key from: https://newsapi.org/register
# Documentation: https://newsapi.org/docs
NEWS_API_KEY=your_news_api_key_here

# CORS Configuration (comma-separated list of allowed origins)
# For production, add your frontend URL here
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.vercel.app
